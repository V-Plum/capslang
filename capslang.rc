#include <windows.h>

1   ICON   "capslang.ico"
1   24     "capslang.manifest"
100 RCDATA "capslang.png"

// Version metadata. Without it the exe looks anonymous, which is one of the
// signals antivirus ML heuristics weigh when flagging unsigned binaries.
// Keep this file ASCII-only: rc.exe reads it as ANSI unless told otherwise.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,5,0
PRODUCTVERSION  1,0,5,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Plum"
            VALUE "FileDescription",  "capslang - keyboard layout switcher"
            VALUE "FileVersion",      "1.0.5.0"
            VALUE "InternalName",     "capslang"
            VALUE "LegalCopyright",   "(c) Plum, 2026"
            VALUE "OriginalFilename", "capslang.exe"
            VALUE "ProductName",      "capslang"
            VALUE "ProductVersion",   "1.0.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
